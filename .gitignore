# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local configuration and environment files
config.sh
.env
.env.*
!.env.example
*.local
.netrc
*.netrc

# Local Herdr state and generated output
cache/
herdr-plugin-state/
*.log
__pycache__/
*.py[cod]

# Local native Herdr build (never publish binaries or runtime state)
.local/

# Native mod editor files generated by the installed Herdr app/checker
/mods/*/gpui-kit.d.ts
/mods/*/jsconfig.json

# Public screenshot gallery; keep all other capture output outside Git.
/docs/screenshots/*.png
!/docs/screenshots/app-light.png
!/docs/screenshots/app-help.png
!/docs/screenshots/app-short.png

# Rust bridge build products and local release assets
/rust-backend/target/
/.release-runtime/
