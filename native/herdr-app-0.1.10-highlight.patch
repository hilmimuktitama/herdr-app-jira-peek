+/// Keep these host fixtures independent of the installed app and other tests.
+struct HighlightState {
+    snapshot: Snapshot,
+    marks: crate::terminal_highlight::Marks,
+    shown: std::collections::HashSet<u64>,
+}
+impl HighlightState {
+    fn new(copy: u64) -> Self {
+        let saved = Self {
+            snapshot: SNAPSHOT.with_borrow_mut(std::mem::take),
+            marks: TERMINAL_HIGHLIGHTS.with_borrow_mut(std::mem::take),
+            shown: SHOWN_COPIES.with_borrow_mut(std::mem::take),
+        };
+        publish_terminals(json!([{ "address": "t1", "state": "live" }]));
+        set_shown_copies(std::collections::HashSet::from([copy]));
+        saved
+    }
+}
+impl Drop for HighlightState {
+    fn drop(&mut self) {
+        SNAPSHOT.with_borrow_mut(|snapshot| *snapshot = std::mem::take(&mut self.snapshot));
+        TERMINAL_HIGHLIGHTS.with_borrow_mut(|marks| *marks = std::mem::take(&mut self.marks));
+        SHOWN_COPIES.with_borrow_mut(|shown| *shown = std::mem::take(&mut self.shown));
+    }
+}
+
+#[gpui::test]
+fn jira_highlight_native_close_revocation_blocks_late_cleanup(cx: &mut TestAppContext) {
+    cx.update(gpui_shell::init);
+    let _state = HighlightState::new(901);
+    let fixture = Fixture::new(r#"
+import { View, div } from "gpui-kit";
+import { setTerminalHighlight } from "herdr";
+import { note } from "fixture";
+export default class extends View {
+  init() { setTerminalHighlight("t1", "DEMO-1"); }
+  close() { note(setTerminalHighlight("t1", "DEMO-2")); }
+  render() { return div(); }
+}"#);
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let calls = seen.clone();
+    gpui_shell::policy::set_default(Policy::new()
+        .with_host_module(module(Instance { name: "highlight-fixture".into(), props: Value::Null }, 901)).unwrap()
+        .with_host_module(HostModule::new("fixture").function("note", move |a| {
+            calls.borrow_mut().push(matches!(a.get(0), Some(HostValue::Bool(true))));
+            Ok(HostValue::Null)
+        })).unwrap());
+    let runtime = ShellRuntime::new_isolated().unwrap();
+    let window = cx.add_window(|_, _| Empty);
+    let root = window.update(cx, |_, window, cx| runtime.try_load(&fixture.0, window, cx).unwrap()).unwrap();
+    assert_eq!(terminal_highlight("t1").as_deref(), Some("DEMO-1"));
+    // Native slot removal revokes before bounded View.close, even if close tries
+    // to reapply. This is independent of the mod's supplemental null clear.
+    revoke_terminal_highlight(901);
+    window.update(cx, |_, window, cx| runtime.close(&root, Instant::now() + Duration::from_millis(250), window, cx).detach()).unwrap();
+    cx.run_until_parked();
+    assert_eq!(*seen.borrow(), [false]);
+    assert_eq!(terminal_highlight("t1"), None);
+    window.update(cx, |_, window, _| window.remove_window()).unwrap();
+}
