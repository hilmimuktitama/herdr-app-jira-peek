+fn highlight_lifetime_policy(copy: u64, lifetimes: Rc<RefCell<Vec<gpui_shell::ApplicationLifetime>>>, retired: Rc<RefCell<Vec<u64>>>) -> Policy {
+    Policy::new().with_host_module(module(Instance { name: "highlight-fixture".into(), props: Value::Null }, copy)).unwrap()
+        .with_host_module(HostModule::new("lifetime").function("capture", move |_| {
+            let lifetime = gpui_shell::current_application_lifetime().unwrap();
+            let id = lifetime.id();
+            let retired = retired.clone();
+            assert!(lifetime.on_retire(move || retired.borrow_mut().push(id)));
+            lifetimes.borrow_mut().push(lifetime);
+            Ok(HostValue::Null)
+        })).unwrap()
+}
