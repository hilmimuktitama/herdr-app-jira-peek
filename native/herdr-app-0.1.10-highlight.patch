+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn frame(lines: &[&str], wraps: &[bool]) -> Frame {
+        Frame { rows: lines.iter().map(|s| Rc::new(s.chars().map(|c| Cell { text: c.to_string(), ..Cell::default() }).collect())).collect(),
+            wraps: wraps.to_vec(), continued_before: false, all: false, cursor: None, cursor_cell: None, bg: Rgb(0, 0, 0) }
+    }
+
+    #[test]
+    fn jira_highlight_validates_literal_bounded_keys_and_addresses() {
+        for key in ["ABC-1", "A_B2-003"] { assert!(valid_query(key)); }
+        for key in ["abc-1", "ABC-1_extra", "ABC-", "1A-1", "ABC-1\n", "ABC-.*", "ÁBC-1", &format!("A-{}", "1".repeat(127))] { assert!(!valid_query(key)); }
+        assert!(valid_query(&format!("A-{}", "1".repeat(126))));
+        assert!(valid_address("t1"));
+        assert!(valid_address("fictional-box/t1"));
+        for target in ["", "/t1", "box/", "box/t1/extra", "t1\n", "box/t1\n"] { assert!(!valid_address(target)); }
+    }
+
+    #[test]
+    fn jira_highlight_requires_complete_tokens() {
+        let f = frame(&["ABC-1 ABC-10 XABC-1 ABC-1_extra (ABC-1) éABC-1 ABC-1é"], &[false]);
+        assert_eq!(spans(&f, "ABC-1"), vec![vec![0..5, 33..38]]);
+    }
+
+    #[test]
+    fn jira_highlight_joins_only_soft_wraps_and_rejects_clipped_edges() {
+        let mut f = frame(&[" ABC-", "1 ", "ABC-", "1 "], &[true, false, false, false]);
+        assert_eq!(spans(&f, "ABC-1"), vec![vec![1..5], vec![0..1], vec![], vec![]]);
+        f = frame(&["ABC-1"], &[true]);
+        assert!(spans(&f, "ABC-1")[0].is_empty());
+        f.wraps[0] = false;
+        f.continued_before = true;
+        assert!(spans(&f, "ABC-1")[0].is_empty());
+    }
+
+    #[test]
+    fn jira_highlight_preserves_unicode_cell_positions_and_hidden_cells() {
+        let mut f = frame(&["中 ABC-1"], &[false]);
+        let row = Rc::make_mut(&mut f.rows[0]);
+        row[0].wide = true;
+        row.insert(1, Cell::default());
+        assert_eq!(spans(&f, "ABC-1"), vec![vec![3..8]]);
+        Rc::make_mut(&mut f.rows[0])[5].text.clear();
+        assert!(spans(&f, "ABC-1")[0].is_empty());
+        let mut f = frame(&[" ABC-1"], &[false]);
+        Rc::make_mut(&mut f.rows[0])[5].text.push('\u{301}');
+        assert!(spans(&f, "ABC-1")[0].is_empty());
+    }
+
+    #[test]
+    fn jira_highlight_copy_ownership_visibility_and_revoke() {
+        let mut marks = Marks::default();
+        marks.register(1); marks.register(2);
+        marks.shown(HashSet::from([1, 2]));
+        assert!(marks.set(2, Some(("box/t1".into(), "XYZ-2".into()))));
+        assert!(marks.set(1, Some(("box/t1".into(), "ABC-1".into()))));
+        assert!(!marks.set(1, Some(("box/t1".into(), "ABC-1".into()))));
+        assert_eq!(marks.query("box/t1"), Some("ABC-1"));
+        marks.shown(HashSet::from([2]));
+        assert_eq!(marks.query("box/t1"), Some("XYZ-2"));
+        marks.shown(HashSet::from([1, 2]));
+        assert_eq!(marks.query("box/t1"), Some("ABC-1"), "re-show restores unchanged JS state");
+        marks.set(1, None);
+        assert_eq!(marks.query("box/t1"), Some("XYZ-2"));
+        marks.revoke(2);
+        assert!(!marks.set(2, Some(("box/t1".into(), "XYZ-2".into()))));
+        assert_eq!(marks.query("box/t1"), None);
+    }
+
+    #[test]
+    fn jira_highlight_disappeared_target_does_not_return_with_reused_address() {
+        let mut marks = Marks::default();
+        marks.register(1); marks.shown(HashSet::from([1]));
+        marks.set(1, Some(("box/t1".into(), "ABC-1".into())));
+        assert!(marks.retain_targets(&HashSet::new()));
+        marks.retain_targets(&HashSet::from(["box/t1".into()]));
+        assert_eq!(marks.query("box/t1"), None);
+    }
+
+    #[test]
+    fn jira_highlight_repeated_wrapped_keys_visit_cells_linearly() {
+        for rows in [32, 64, 128] {
+            let line = "ABC-1 ".repeat(20);
+            let lines = vec![line.as_str(); rows];
+            let mut wraps = vec![true; rows]; wraps[rows - 1] = false;
+            let f = frame(&lines, &wraps);
+            let mut visits = 0;
+            let found = compute_spans(&f, "ABC-1", || visits += 1);
+            assert_eq!(found.iter().map(Vec::len).sum::<usize>(), rows * 20);
+            assert!(visits <= rows * line.len() * 3, "each cell is visited at most once per mapping pass: {visits}");
+        }
+    }
+
+    #[test]
+    fn jira_highlight_match_cache_tracks_rows_wraps_query_and_disabled_state() {
+        let original = frame(&["ABC-1 ", "ABC-1 "], &[false, false]);
+        let mut f = frame(&[], &[]);
+        f.rows = original.rows.clone(); f.wraps = original.wraps.clone();
+        let mut cache = RowCache::default();
+        let first = cache.decorate(&mut f, Some("ABC-1"));
+        let decorated = f.rows[0].clone();
+        for _ in 0..100 {
+            f.rows = original.rows.clone();
+            let same = cache.decorate(&mut f, Some("ABC-1"));
+            assert!(Rc::ptr_eq(&first, &same));
+            assert!(Rc::ptr_eq(&decorated, &f.rows[0]));
+        }
+        assert_eq!(cache.parses, 1, "unchanged paints never reparse cell text");
+        f.rows = original.rows.clone(); f.wraps[0] = true;
+        cache.decorate(&mut f, Some("ABC-1"));
+        assert_eq!(cache.parses, 2);
+        f.rows = original.rows.clone(); f.continued_before = true;
+        cache.decorate(&mut f, Some("ABC-1"));
+        assert_eq!(cache.parses, 3);
+        f.rows = original.rows.clone();
+        cache.decorate(&mut f, Some("XYZ-2"));
+        assert_eq!(cache.parses, 4);
+        f.rows = original.rows.clone(); Rc::make_mut(&mut f.rows[1])[0].text = "X".into();
+        cache.decorate(&mut f, Some("XYZ-2"));
+        assert_eq!(cache.parses, 5);
+        for _ in 0..100 {
+            f.rows = original.rows.clone();
+            assert!(cache.decorate(&mut f, None).is_empty());
+            assert!(Rc::ptr_eq(&f.rows[0], &original.rows[0]));
+        }
+        assert_eq!(cache.parses, 5, "disabled paints do no matching");
+    }
+
+    #[test]
+    fn jira_highlight_generation_rollback_and_cleanup_are_isolated() {
+        let mut marks = Marks::default(); marks.register(1); marks.shown(HashSet::from([1]));
+        marks.set_generation(1, 10, Some(("t1".into(), "ABC-1".into())));
+        marks.set_generation(1, 11, Some(("t1".into(), "XYZ-2".into())));
+        assert_eq!(marks.query("t1"), Some("XYZ-2"));
+        marks.retire_generation(1, 11);
+        assert_eq!(marks.query("t1"), Some("ABC-1"), "failed candidate restores predecessor");
+        marks.set_generation(1, 12, Some(("t1".into(), "XYZ-2".into())));
+        marks.retire_generation(1, 10);
+        assert_eq!(marks.query("t1"), Some("XYZ-2"), "old cleanup cannot erase replacement");
+        marks.retire_generation(1, 10);
+        assert_eq!(marks.query("t1"), Some("XYZ-2"), "cleanup is idempotent");
+        marks.set_generation(1, 13, None);
+        assert_eq!(marks.query("t1"), None);
+        marks.retire_generation(1, 13);
+        assert_eq!(marks.query("t1"), Some("XYZ-2"), "failed clear also rolls back");
+    }
+
+    #[test]
+    fn jira_highlight_row_cache_preserves_selection_and_unchanged_rows() {
+        let mut original = frame(&[" ABC-1 ", " unrelated "], &[false, false]);
+        let selected = &mut Rc::make_mut(&mut original.rows[0])[1];
+        selected.selected = true; selected.bg = Some(Rgb(10, 30, 90));
+        let mut cache = RowCache::default();
+        let mut f = frame(&[], &[]); f.rows = original.rows.clone();
+        cache.decorate(&mut f, Some("ABC-1"));
+        let marked = f.rows[0].clone();
+        assert_eq!(f.rows[0][1].bg, original.rows[0][1].bg);
+        assert_eq!(f.rows[0][2].bg, Some(BACKGROUND));
+        assert!(Rc::ptr_eq(&f.rows[1], &original.rows[1]));
+        f.rows = original.rows.clone(); cache.decorate(&mut f, Some("ABC-1"));
+        assert!(Rc::ptr_eq(&f.rows[0], &marked));
+        f.rows = original.rows.clone(); cache.decorate(&mut f, None);
+        assert!(Rc::ptr_eq(&f.rows[0], &original.rows[0]));
+    }
