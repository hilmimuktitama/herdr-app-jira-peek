+#[gpui::test]
+fn jira_highlight_native_reload_success_isolates_old_cleanup_and_cancels_pending_work(cx: &mut TestAppContext) {
+    cx.update(gpui_shell::init);
+    let _state = HighlightState::new(903);
+    let fixture = Fixture::new(r#"
+import { View, div } from "gpui-kit";
+import { setTerminalHighlight } from "herdr";
+import { capture } from "lifetime";
+import { wait } from "pending";
+export default class extends View {
+  init(_props, cx) {
+    capture(); setTerminalHighlight("t1", "DEMO-1");
+    cx.spawn(async () => { await wait(); setTerminalHighlight("t1", "DEMO-999"); });
+  }
+  render() { return div(); }
+}"#);
+    let lifetimes = Rc::new(RefCell::new(Vec::new()));
+    let retired = Rc::new(RefCell::new(Vec::new()));
+    let (tx, rx) = async_channel::bounded::<()>(1);
+    let receiver = Rc::new(RefCell::new(Some(rx)));
+    gpui_shell::policy::set_default(highlight_lifetime_policy(903, lifetimes.clone(), retired.clone())
+        .with_host_module(HostModule::new("pending").async_function("wait", move |_| {
+            let rx = receiver.borrow_mut().take().expect("only the old generation waits");
+            Ok(async move { let _ = rx.recv().await; Ok(HostValue::Null) })
+        })).unwrap());
+    let runtime = ShellRuntime::new_isolated().unwrap();
+    let window = cx.add_window(|_, _| Empty);
+    let root = window.update(cx, |_, window, cx| runtime.try_load(&fixture.0, window, cx).unwrap()).unwrap();
+    cx.run_until_parked();
+    assert_eq!(terminal_highlight("t1").as_deref(), Some("DEMO-1"));
+    std::fs::write(fixture.0.join("main.js"), r#"
+import { View, div } from "gpui-kit";
+import { setTerminalHighlight } from "herdr";
+import { capture } from "lifetime";
+export default class extends View {
+  init() { capture(); setTerminalHighlight("t1", "DEMO-2"); }
+  render() { return div(); }
+}"#).unwrap();
+    // reload_now and the fallback watcher share this exact runtime reload path.
+    window.update(cx, |_, window, cx| runtime.reload_now(&root, window, cx).unwrap()).unwrap();
+    cx.run_until_parked();
+    assert_eq!(terminal_highlight("t1").as_deref(), Some("DEMO-2"));
+    assert!(tx.is_closed(), "retired generation's native future must be canceled");
+    assert!(!lifetimes.borrow()[0].is_active());
+    assert!(lifetimes.borrow()[1].is_active());
+    assert_eq!(*retired.borrow(), [lifetimes.borrow()[0].id()]);
+    assert!(!lifetimes.borrow()[0].on_retire(|| panic!("retired cleanup cannot register again")));
+    // No View.close() is provided: native generation retirement clears the new mark.
+    window.update(cx, |_, window, cx| runtime.close_now(&root, Instant::now() + Duration::from_millis(250), window, cx)).unwrap();
+    assert_eq!(terminal_highlight("t1"), None);
+    assert_eq!(retired.borrow().len(), 2);
+    window.update(cx, |_, window, cx| runtime.close_now(&root, Instant::now() + Duration::from_millis(250), window, cx)).unwrap();
+    assert_eq!(retired.borrow().len(), 2, "each native cleanup runs exactly once");
+    window.update(cx, |_, window, _| window.remove_window()).unwrap();
+}
