+    let Some((project, number)) = query.split_once('-') else { return false };
+    project.bytes().all(|b| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_')
+        && !number.is_empty() && number.bytes().all(|b| b.is_ascii_digit())
+}
+
+pub fn valid_address(address: &str) -> bool {
+    // Keep the exact address returned by terminals(): local addresses have no
+    // machine prefix. Snapshot membership, not an invented prefix, is authoritative.
+    !address.is_empty()
+        && !address.chars().any(|c| c.is_whitespace() || c.is_control())
+        && match address.split_once('/') {
+            Some((machine, terminal)) => !machine.is_empty() && !terminal.is_empty() && !terminal.contains('/'),
+            None => true,
+        }
+}
+
+type Mark = Option<(String, String)>;
+
+#[derive(Default)]
+pub struct Marks {
+    // A reload candidate may coexist briefly with its predecessor. Only the newest
+    // generation contributes a desired mark; retiring a failed candidate restores
+    // the predecessor. A null mark deliberately masks the predecessor until commit.
+    marks: BTreeMap<u64, BTreeMap<u64, Mark>>,
+    shown: HashSet<u64>,
+    owners: HashSet<u64>,
+}
+
+impl Marks {
+    pub fn register(&mut self, copy: u64) { self.owners.insert(copy); }
+
+    /// Lowest copy ID (oldest loaded copy) wins; reassertion cannot steal precedence.
+    pub fn query(&self, terminal: &str) -> Option<&str> {
+        self.marks.iter().filter(|(copy, _)| self.shown.contains(*copy))
+            .filter_map(|(_, generations)| generations.last_key_value()?.1.as_ref())
+            .find(|(target, _)| target == terminal).map(|(_, query)| query.as_str())
+    }
+
+    #[cfg(test)]
+    pub fn set(&mut self, copy: u64, mark: Mark) -> bool { self.set_generation(copy, 0, mark) }
+
+    pub fn has_generation(&self, copy: u64, generation: u64) -> bool {
+        self.marks.get(&copy).is_some_and(|marks| marks.contains_key(&generation))
+    }
+
+    pub fn set_generation(&mut self, copy: u64, generation: u64, mark: Mark) -> bool {
+        if !self.owners.contains(&copy) { return false; }
+        let generations = self.marks.entry(copy).or_default();
+        if generations.get(&generation) == Some(&mark) { return false; }
+        let before = generations.last_key_value().and_then(|(_, mark)| mark.clone());
+        generations.insert(generation, mark);
+        before != generations.last_key_value().and_then(|(_, mark)| mark.clone())
+    }
+
+    pub fn retire_generation(&mut self, copy: u64, generation: u64) -> bool {
+        let Some(generations) = self.marks.get_mut(&copy) else { return false };
+        let before = generations.last_key_value().and_then(|(_, mark)| mark.clone());
+        generations.remove(&generation);
+        let changed = before != generations.last_key_value().and_then(|(_, mark)| mark.clone());
+        if generations.is_empty() { self.marks.remove(&copy); }
+        changed
+    }
+
+    pub fn revoke(&mut self, copy: u64) -> bool {
+        self.owners.remove(&copy);
+        self.marks.remove(&copy).is_some()
+    }
+
+    pub fn owns(&self, copy: u64) -> bool { self.owners.contains(&copy) }
+
+    pub fn shown(&mut self, shown: HashSet<u64>) -> bool {
+        if self.shown == shown { return false; }
+        // Visibility gates painting only. JS may deduplicate unchanged desired state.
+        self.shown = shown;
+        true
+    }
+
+    pub fn retain_targets(&mut self, live: &HashSet<String>) -> bool {
+        self.clear_targets(|target| !live.contains(target))
+    }
+
+    pub fn forget_target(&mut self, target: &str) -> bool {
+        self.clear_targets(|t| t == target)
+    }
+
+    fn clear_targets(&mut self, clear: impl Fn(&str) -> bool) -> bool {
+        let mut changed = false;
+        for generations in self.marks.values_mut() {
+            for mark in generations.values_mut() {
+                if mark.as_ref().is_some_and(|(target, _)| clear(target)) {
+                    *mark = None;
+                    changed = true;
+                }
+            }
+        }
+        changed
+    }
+}
+
+// Includes non-ASCII neighbors conservatively: a Jira token embedded in a Unicode
+// identifier is not a standalone token. Combining marks never become a delimiter.
+fn token_neighbor(c: char) -> bool { c.is_alphanumeric() || c == '_' || !c.is_ascii() }
+
+/// Match only rendered graphemes. Empty/hidden cells are separators; wide tails
+/// consume a column without inserting a separator. Never join a hard newline.
+/// At clipped viewport edges, reject uncertain token boundaries rather than
+/// reading hidden scrollback or reporting a prefix as a complete key.
+pub fn spans(frame: &Frame, query: &str) -> Vec<Vec<std::ops::Range<usize>>> {
+    compute_spans(frame, query, || {})
+}
+
+// The visit hook gives tests proportional-work evidence without timing thresholds.
+// Its empty production closure is optimized away.
+fn compute_spans(frame: &Frame, query: &str, mut visit: impl FnMut()) -> Vec<Vec<std::ops::Range<usize>>> {
+    let mut result: Vec<Vec<std::ops::Range<usize>>> = vec![Vec::new(); frame.rows.len()];
+    if !valid_query(query) { return result; }
+    let mut first = 0;
+    while first < frame.rows.len() {
+        let mut last = first;
+        while last + 1 < frame.rows.len() && frame.wraps.get(last) == Some(&true) { last += 1; }
+        let mut text = String::new();
+        let mut cells = Vec::new();
+        for y in first..=last {
+            let mut tail = false;
+            for (x, cell) in frame.rows[y].iter().enumerate() {
+                visit();
+                if tail { tail = false; continue; }
+                // Ghostty inserts this padding when a two-cell glyph cannot fit.
+                // It consumes a screen column, not a logical text character.
+                if cell.spacer_head { continue; }
+                let start = text.len();
+                text.push_str(if cell.text.is_empty() { " " } else { &cell.text });
+                cells.push((start, text.len(), y, x));
+                tail = cell.wide;
+            }
+        }
+        let mut at = 0;
+        for (start, _) in text.match_indices(query) {
+            let end = start + query.len();
+            let left = text[..start].chars().next_back();
+            let right = text[end..].chars().next();
+            if left.is_some_and(token_neighbor) || right.is_some_and(token_neighbor)
+                || (start == 0 && first == 0 && frame.continued_before)
+                || (end == text.len() && frame.wraps.get(last) == Some(&true)) { continue; }
+            // Match offsets are monotonic: visit each mapping entry at most once,
+            // even for thousands of repeated keys on one soft-wrapped logical line.
+            while at < cells.len() && cells[at].0 < start { at += 1; visit(); }
+            let begin = at;
+            while at < cells.len() && cells[at].1 <= end { at += 1; visit(); }
+            // Do not highlight a partial grapheme (e.g. a combining mark on a digit).
+            if begin == at || cells[begin].0 != start || cells[at - 1].1 != end { continue; }
+            for &(_, _, y, x) in &cells[begin..at] {
+                visit();
+                match result[y].last_mut() {
+                    Some(range) if range.end == x => range.end = x + 1,
+                    _ => result[y].push(x..x + 1),
+                }
+            }
+        }
+        first = last + 1;
+    }
+    result
+}
+
+type MatchSpans = Vec<Vec<std::ops::Range<usize>>>;
+
+#[derive(Default)]
+pub struct RowCache {
+    rows: Vec<(Rc<Vec<Cell>>, Vec<std::ops::Range<usize>>, Rc<Vec<Cell>>)>,
+    query: Option<String>,
+    wraps: Vec<bool>,
+    continued_before: bool,
+    matches: Rc<MatchSpans>,
+    #[cfg(test)]
+    parses: usize,
+}
+
+impl RowCache {
+    /// Cache matching by original row identity, wrap metadata and query, then keep
+    /// decorated row identities independently. Unrelated rows keep their drawings.
+    pub fn decorate(&mut self, frame: &mut Frame, query: Option<&str>) -> Rc<MatchSpans> {
+        let Some(query) = query else {
+            // No allocations, parsing or per-row work while highlighting is disabled.
+            if self.query.take().is_some() {
+                self.rows.clear();
+                self.wraps.clear();
+                self.matches = Rc::default();
+            }
+            return self.matches.clone();
+        };
+        let same = self.query.as_deref() == Some(query)
+            && self.wraps == frame.wraps && self.continued_before == frame.continued_before
+            && self.rows.len() == frame.rows.len()
+            && self.rows.iter().zip(&frame.rows).all(|((old, _, _), row)| Rc::ptr_eq(old, row));
+        if !same {
+            self.matches = Rc::new(spans(frame, query));
+            self.query = Some(query.to_owned());
+            self.wraps.clone_from(&frame.wraps);
+            self.continued_before = frame.continued_before;
+            #[cfg(test)]
+            { self.parses += 1; }
+        }
+        self.rows.truncate(frame.rows.len());
+        for (y, source) in frame.rows.iter_mut().enumerate() {
+            let ranges = &self.matches[y];
+            if same {
+                *source = self.rows[y].2.clone();
+                continue;
+            }
+            let cached = self.rows.get(y).filter(|(old, old_ranges, _)| Rc::ptr_eq(old, source) && old_ranges == ranges);
+            let decorated = if let Some((_, _, row)) = cached { row.clone() }
+                else if ranges.is_empty() { source.clone() }
+                else {
+                    let mut row = source.as_ref().clone();
+                    for range in ranges {
+                        for cell in &mut row[range.clone()] {
+                            if !cell.selected {
+                                cell.bg = Some(BACKGROUND);
+                                cell.fg = FOREGROUND;
+                                cell.faint = false;
+                            }
+                        }
+                    }
+                    Rc::new(row)
+                };
+            let entry = (source.clone(), ranges.clone(), decorated.clone());
+            if y < self.rows.len() { self.rows[y] = entry; } else { self.rows.push(entry); }
+            *source = decorated;
+        }
+        self.matches.clone()
+    }
+}
