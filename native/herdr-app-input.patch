-use std::panic::Location;
+use std::{cell::RefCell, collections::VecDeque, panic::Location, rc::Rc};
+
+/// HERDR: positions live as long as the owning ScriptView, including hide/show.
+/// Bound retention to 64 named panes; no content or positions are persisted.
+#[derive(Default)]
+pub(crate) struct ScrollPositions(RefCell<VecDeque<(ElementId, ScrollHandle)>>);
+
+thread_local! {
+    static POSITIONS: RefCell<Option<Rc<ScrollPositions>>> = const { RefCell::new(None) };
+}
+
+pub(crate) struct ScrollScope(Option<Rc<ScrollPositions>>);
+impl Drop for ScrollScope {
+    fn drop(&mut self) { POSITIONS.with(|p| *p.borrow_mut() = self.0.take()); }
+}
+
+pub(crate) fn retain_for(positions: &Rc<ScrollPositions>) -> ScrollScope {
+    ScrollScope(POSITIONS.with(|p| p.replace(Some(positions.clone()))))
+}
+
+fn retained_handle(id: &ElementId) -> Option<ScrollHandle> {
+    POSITIONS.with(|p| {
+        let p = p.borrow();
+        let mut entries = p.as_ref()?.0.borrow_mut();
+        let handle = entries.iter().position(|(key, _)| key == id)
+            .and_then(|i| entries.remove(i)).map(|(_, handle)| handle).unwrap_or_default();
+        entries.push_back((id.clone(), handle.clone()));
+        if entries.len() > 64 { entries.pop_front(); }
+        Some(handle)
+    })
+}
 
