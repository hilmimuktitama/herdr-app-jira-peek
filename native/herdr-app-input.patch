 impl ShellRuntime {
+    /// HERDR: focus a retained mod synchronously, before the next platform input.
+    pub fn focus(
+        self: &Rc<Self>, root: &Entity<ShellRoot>, window: &mut Window, cx: &mut App,
+    ) -> anyhow::Result<()> {
+        let view = root.read(cx).application().ok_or_else(|| anyhow::anyhow!("mod has no application"))?.view.clone();
+        let object = view.read(cx).object().clone();
+        let policy = view.read(cx).policy();
+        let (_scope, generation) = scope::enter_with_application(
+            self, window, cx, ScopePhase::Event, Some(view.clone()), policy, object.application_generation(),
+        );
+        self.with_js(|ctx| {
+            let instance = object.restore(ctx)?;
+            let focus: Value = instance.get("focus")?;
+            let focus = focus.into_function().ok_or_else(|| Exception::throw_type(ctx, "View.focus(cx) is required"))?;
+            let result: Value = focus.call((This(instance), context_object(ctx, ContextBinding::Call(generation))?))?;
+            if result.is_promise() {
+                return Err(Exception::throw_type(ctx, "View.focus(cx) must be synchronous"));
+            }
+            Ok(())
+        })?;
+        scheduler::drain_runtime_jobs(self, window, cx);
+        view.update(cx, |view, cx| view.refresh(cx));
+        Ok(())
+    }
