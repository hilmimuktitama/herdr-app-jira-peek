+
+// A shortcut must mount and focus its input before the following text event,
+// including when a retained mod had no element in the previous frame.
+struct FocusEntry {
+    root: Option<gpui::Entity<ShellRoot>>,
+    folder: PathBuf,
+    runtime: Rc<ShellRuntime>,
+    terminal: gpui::FocusHandle,
+    visible: bool,
+    leaked: Rc<Cell<usize>>,
+}
+impl Render for FocusEntry {
+    fn render(&mut self, _: &mut gpui::Window, cx: &mut gpui::Context<Self>) -> impl IntoElement {
+        use gpui::{InteractiveElement, ParentElement, Styled};
+        let mut tree = gpui::div().size_full().track_focus(&self.terminal)
+            .on_key_down(cx.listener(|this, event: &gpui::KeyDownEvent, window, cx| {
+                if event.keystroke == gpui::Keystroke::parse("ctrl-shift-j").unwrap() {
+                    this.visible = true;
+                    let root = this.root.get_or_insert_with(|| this.runtime.try_load(&this.folder, window, cx).unwrap());
+                    this.runtime.focus(root, window, cx).unwrap();
+                    cx.notify();
+                    cx.stop_propagation();
+                } else if this.terminal.is_focused(window) {
+                    this.leaked.set(this.leaked.get() + 1);
+                }
+            }));
+        if self.visible && let Some(root) = &self.root { tree = tree.child(root.clone()); }
+        tree
+    }
+}
+
+#[gpui::test]
+fn focus_entry_accepts_immediate_text_from_visible_and_hidden_compact_views(cx: &mut TestAppContext) {
+    cx.update(gpui_shell::init);
+    let fixture = Fixture::new(r#"
+import { View, div } from "gpui-kit";
+import { Input, InputState } from "gpui-base";
+import { note } from "fixture";
+export default class extends View {
+  init(p,cx) {
+    this.reader=cx.focus_handle();
+    this.input=InputState.new();
+    this.input.on("submit", (_,cx) => {
+      note(this.input.value()); this.edit=false; this.reader.focus(); cx.notify();
+    });
+  }
+  focus(cx) { this.edit=true; this.input.set_value(""); this.input.focus(); cx.notify(); }
+  render() { return this.edit ? Input.new(this.input) : div().id("reader").track_focus(this.reader).child("Reading"); }
+}"#);
+    let values = Rc::new(RefCell::new(Vec::new()));
+    let calls = values.clone();
+    gpui_shell::policy::set_default(Policy::new().with_host_module(
+        HostModule::new("fixture").function("note", move |args| {
+            calls.borrow_mut().push(args.string(0)?.to_owned()); Ok(HostValue::Null)
+        })
+    ).unwrap());
+    let runtime = ShellRuntime::new_isolated().unwrap();
+    let leaked = Rc::new(Cell::new(0));
+    let window = cx.add_window(|window, cx| {
+        let terminal = cx.focus_handle(); terminal.focus(window, cx);
+        FocusEntry { root: None, folder: fixture.0.clone(), runtime: runtime.clone(), terminal,
+            visible: false, leaked: leaked.clone() }
+    });
+    let mut visual = VisualTestContext::from_window(*window.deref(), cx);
+    for trial in 0..41 {
+        window.update(&mut visual, |view, window, cx| {
+            view.visible = trial < 21;
+            view.terminal.focus(window, cx); cx.notify();
+        }).unwrap();
+        visual.update(|window, cx| window.draw(cx).clear(cx));
+        visual.update(|window, cx| {
+            // Deliberately no executor drain, delay, or explicit draw between keys.
+            for key in ["ctrl-shift-j", "c", "a", "t", "a", "l", "o", "g", "enter"] {
+                window.dispatch_keystroke(gpui::Keystroke::parse(key).unwrap(), cx);
+            }
+        });
+        visual.run_until_parked();
+        assert_eq!(values.borrow().len(), trial + 1, "submission {trial}");
+        assert_eq!(values.borrow()[trial], "catalog", "text for trial {trial}");
+        assert_eq!(leaked.get(), 0, "terminal keys in trial {trial}");
+    }
+}
+
+struct ScrollFocus {
+    header: gpui::FocusHandle,
+    bottom: gpui::FocusHandle,
+    scroll: gpui::ScrollHandle,
+}
+impl Render for ScrollFocus {
+    fn render(&mut self, _: &mut gpui::Window, _: &mut gpui::Context<Self>) -> impl IntoElement {
+        use gpui::{InteractiveElement, ParentElement, StatefulInteractiveElement, Styled};
+        gpui::div().flex().flex_col().w(gpui::px(100.)).h(gpui::px(120.))
+            .child(gpui::div().id("header").h(gpui::px(20.)).flex_none().track_focus(&self.header))
+            .child(gpui::div().id("scroll").h(gpui::px(100.)).flex_none().overflow_y_scroll().track_scroll(&self.scroll)
+                .child(gpui::div().h(gpui::px(480.)))
+                .child(gpui::div().id("bottom").h(gpui::px(20.)).track_focus(&self.bottom)))
+    }
+}
+
+#[gpui::test]
+fn focus_reveals_descendants_without_scrolling_unrelated_siblings(cx: &mut TestAppContext) {
+    let scroll = gpui::ScrollHandle::new();
+    let window = cx.add_window(|_, cx| ScrollFocus { header: cx.focus_handle(), bottom: cx.focus_handle(), scroll: scroll.clone() });
+    let mut visual = VisualTestContext::from_window(*window.deref(), cx);
+    visual.update(|window, cx| window.draw(cx).clear(cx));
+    scroll.set_offset(gpui::point(gpui::px(0.), gpui::px(-150.)));
+    window.update(&mut visual, |view, window, cx| view.header.focus(window, cx)).unwrap();
+    visual.update(|window, cx| window.draw(cx).clear(cx));
+    assert_eq!(scroll.offset().y, gpui::px(-150.), "toolbar focus must preserve the reading position");
+    window.update(&mut visual, |view, window, cx| view.bottom.focus(window, cx)).unwrap();
+    visual.update(|window, cx| window.draw(cx).clear(cx));
+    assert_eq!(scroll.offset().y, gpui::px(-400.), "the focused last control must become visible");
+}
